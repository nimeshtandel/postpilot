# Copy to .dev.vars for local development (`npm run dev`). Never commit .dev.vars.
# In production these are Worker secrets: run `npm run setup:secrets`, then add platform keys
# with `npx wrangler secret put <NAME>`.
NEXTJS_ENV=development
APP_URL=http://localhost:3000

# Generate each with: openssl rand -base64 32   (CRON_SECRET: openssl rand -hex 16)
AUTH_SECRET=
ENCRYPTION_KEY=
CRON_SECRET=

# AI captions (Claude)
ANTHROPIC_API_KEY=

# Facebook + Instagram (one Meta app)
META_APP_ID=
META_APP_SECRET=
# Threads
THREADS_APP_ID=
THREADS_APP_SECRET=
# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# X (Twitter)
X_CLIENT_ID=
X_CLIENT_SECRET=
# YouTube (Google Cloud OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
